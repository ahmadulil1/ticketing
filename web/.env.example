# Salin file ini ke .env sebelum build (env tidak masuk repo).
# WebSocket untuk real-time (chat, remote desktop viewer).
# Wajib diset di web app — tanpa ini WS fallback ke ws://localhost dan live-update mati.
VITE_WS_URL=wss://ticketing.marisoncloud.com

# API pakai path relatif (lihat src/lib/api.ts -> baseURL "/api"), jadi VITE_API_URL
# tak perlu diset untuk web yang disajikan lewat domain yang sama.
# VITE_API_URL=https://ticketing.marisoncloud.com/api

# Alternatif LAN-only (default lama):
# VITE_WS_URL=ws://192.168.0.100
