{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Ticketing",
  "version": "1.0.2",
  "identifier": "com.ticketing.desktop",
  "build": {
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "mini",
        "title": "Ticketing",
        "width": 400,
        "height": 600,
        "minWidth": 350,
        "minHeight": 500,
        "resizable": true,
        "decorations": false,
        "transparent": false,
        "alwaysOnTop": false,
        "visible": false,
        "skipTaskbar": false
      },
      {
        "label": "pet-overlay",
        "title": "Pet",
        "url": "index.html#pet-overlay",
        "width": 480,
        "height": 150,
        "minWidth": 280,
        "minHeight": 120,
        "maxWidth": 500,
        "maxHeight": 190,
        "resizable": false,
        "decorations": false,
        "transparent": true,
        "alwaysOnTop": true,
        "visible": true,
        "skipTaskbar": true,
        "focus": false
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; connect-src 'self' ipc://localhost http://ipc.localhost http://192.168.0.100:3000 ws://192.168.0.100:3000; img-src 'self' data:"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": ["icons/icon.ico", "icons/icon.png"]
  }
}
